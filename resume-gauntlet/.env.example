# On Windows, use `npm run set-key` instead of this file: it saves the key to your
# Windows user environment, outside the project folder.
#
# On macOS or Linux (or if you prefer a file): copy this to .env and fill in your key.
# Never commit .env. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

